@Library('microservices-pipeline-library') _

pipeline {
    agent any
    
    environment {
        SERVICE_NAME = 'receiver' // Change for each service: receiver, storage, processing, analyzer
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }
    
    stages {
        stage('Lint') {
            steps {
                script {
                    pipelineSteps.lint('./receiver') // Adjust path if needed
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    pipelineSteps.securityScan('./receiver') // Adjust path if needed
                }
            }
            post {
                failure {
                    echo 'Security vulnerabilities detected! Pipeline failed.'
                }
            }
        }
        
        stage('Package') {
            steps {
                script {
                    sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                    pipelineSteps.buildAndPush(env.SERVICE_NAME, env.SERVICE_NAME, "v1.${BUILD_NUMBER}")
                }
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    pipelineSteps.deploy(env.SERVICE_NAME)
                }
            }
        }
    }
    
    post {
        always {
            sh 'docker logout'
        }
    }
}